# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# Stripe (prepared but not activated)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional AI gym design (server only; never NEXT_PUBLIC_).
OPENAI_API_KEY=
# Set a model available to your API project that supports Responses + Structured Outputs.
OPENAI_GYM_MODEL=

# Mobile billing: disabled by default. Use isolated staging and approved test users for sandbox.
MOBILE_BILLING_ENABLED=false
MOBILE_BILLING_ENVIRONMENT=sandbox
MOBILE_BILLING_SANDBOX_USERS=
MOBILE_BILLING_RELEASE_APPROVED=false
APPLE_APP_ID=
APPLE_BUNDLE_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Comma-separated base64 DER Apple roots from official Apple PKI; server-only.
APPLE_ROOT_CERTIFICATES_BASE64=
APPLE_PROMOTION_OFERTA_ZILEI_SKU=
APPLE_PROMOTION_ANUNTURILE_ZILEI_SKU=
APPLE_PROMOTION_SUPER_PRET_SKU=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PROMOTION_OFERTA_ZILEI_SKU=
GOOGLE_PROMOTION_ANUNTURILE_ZILEI_SKU=
GOOGLE_PROMOTION_SUPER_PRET_SKU=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=
